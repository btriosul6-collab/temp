        "name": "function 7",
        "func": "const now = new Date()\n\nconst dataHora = now.toLocaleString('pt-BR', {\n    timeZone: 'America/Sao_Paulo',\n    year: 'numeric',\n    month: '2-digit',\n    day: '2-digit',\n    hour: '2-digit',\n    minute: '2-digit',\n    second: '2-digit'\n})\n\n// Função para gerar temperatura\nfunction gerarTemperatura(min, max) {\n    return Number((Math.random() * (max - min) + min).toFixed(2))\n}\n\n// Gerando 4 temperaturas\nconst temperatura1 = gerarTemperatura(15, 30)\nconst temperatura2 = gerarTemperatura(15, 30)\nconst temperatura3 = gerarTemperatura(15, 30)\nconst temperatura4 = gerarTemperatura(15, 30)\n\nmsg.payload = [[\n    dataHora,\n    temperatura1,\n    temperatura2,\n    temperatura3,\n    temperatura4\n]]\n\nreturn msg",
